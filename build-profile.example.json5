{
  /*
   * 公开仓库里的**模板**：真正的 `build-profile.json5` 不进版本库（见 .gitignore）。
   *
   * 用法：把它复制成同目录的 `build-profile.json5`，然后
   *   ① 用 DevEco Studio 打开工程 → File > Project Structure > Signing Configs →
   *      "Automatically generate signature"（登录华为账号后一键生成，会自己把本地路径与
   *      密码写进 `build-profile.json5` 的 `signingConfigs` 里 —— 那些不该进仓库）；
   *   ② 或者手工把下面 `signingConfigs` 里的路径 / 别名 / 密码换成你自己的。
   *
   * 没有签名配置时 `assembleHap` 会停在签名那一步（编译本身是通的），
   * 命令行构建见 tools/build.ps1 与 README 的「构建」一节。
   */
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          // 这三份由 DevEco 的签名向导生成在 ~/.ohos/config/ 下（绝对路径按你的机器写）。
          "certpath": "C:\\Users\\<you>\\.ohos\\config\\default_<Project>_<hash>.cer",
          "profile": "C:\\Users\\<you>\\.ohos\\config\\default_<Project>_<hash>.p7b",
          "storeFile": "C:\\Users\\<you>\\.ohos\\config\\default_<Project>_<hash>.p12",
          "keyAlias": "debugKey",
          "keyPassword": "<由 DevEco 写入，是一串加密后的值>",
          "storePassword": "<同上>",
          "signAlg": "SHA256withECDSA"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        // 目标 API 26、**兼容 API 20**（HarmonyOS 6.0.0）：包要能装在 20 起的机器上，
        // 所以 26 才有的接口（uiMaterial / systemMaterial）与 23 才有的 HDS 系统材质
        // 全部按运行设备能力降级 —— 判定见 core/PlatformCap，降级点见 MaterialSurface
        // （SurfaceModifier / SelectSurfaceModifier）、ImmersiveLight（titleScrollEffectType）、
        // Index（标题栏样式助手）、CreatePost、DirectPage、MediaPrefetch。
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
