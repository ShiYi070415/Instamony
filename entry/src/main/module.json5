{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone", "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      // 查当前网络是 Wi-Fi 还是蜂窝：预下载（下一条视频预缓冲、后面几页接口、封面预取）
      // 只在 Wi-Fi/不计费网络下做，蜂窝网下一律不预下载（见 core/NetworkState）。
      // 官方文档明确 getDefaultNetSync 需要这个权限（normal 级、系统授权，装上即生效）。
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      }
    ],
    // 应用级开启沉浸光感（官方文档「开启沉浸光感」）：
    //   name 固定为 ohos.arkui.UIMaterial.state，value = enable 表示**全局开启**，
    //   disable 表示全局禁用（组件级也压不住），default/不配表示按组件默认。
    //   该配置**只在 entry 类型的 module 中生效**，本模块正是 entry。
    // 开在应用级是为了"全局自适应"：支持沉浸光感的组件（Navigation / 底部 TabBar /
    // 各类弹窗 / Slider / Toggle / Select 等）批量生效，不用一个个去写 systemMaterial；
    //   具体某个组件要什么档次的材质，再由组件级接口覆盖（组件级优先级更高）。
    // 副作用提醒：开启后指定弹窗类与 Slider/Toggle/Select 的材质是**全页面**生效的，
    //   其余组件只在 Navigation/NavDestination 标题栏或 barPosition=End 的底部 TabBar 中生效。
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:splash_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          /*
           * 深链入口（需求/课程演示：让"外部世界"能直接进到本 App 的某个界面）。
           *
           * 这一段就是"网页/其他 App → 原生"的桥头：浏览器里打开
           *     instarmony://open?route=post&id=ABC
           * 系统会按 scheme+host 精确匹配到这里，把命中的 URI 通过 Want.uri 交给 EntryAbility
           * （冷启 onCreate / 热启 onNewWant）。解析与执行见 core/DeepLink 与 pages/DeepLink。
           *
           * 注意两点：
           *   1) `entities` 这里是 `entity.system.browsable`：让本 App 对"浏览这类 URI"的系统
           *      分发可见，浏览器才会把 instarmony:// 交给我们（home 那条用的是 entity.system.home，
           *      两者职责不同，所以是两条独立的 skill）。
           *   2) `scheme` 必须与 core/DeepLink 里的 DEEPLINK_SCHEME 完全一致，改一处就得改两处。
           */
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "instarmony",
                "host": "open"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
