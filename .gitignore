/node_modules
/oh_modules
/local.properties
/.idea
**/build
/.hvigor
/.hvigor-home
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
# 打包产物
*.hap
*.har
*.abc
# 本机签名配置（含本机绝对路径与签名密码）；仓库里只放 build-profile.example.json5
/build-profile.json5
# 诊断/临时文件（日志、截图、UI 转储、抓包样本）
/.tmp/
/.tmp-w.json
/.dsh-work/
/tools/*.json
# DevEco CodeGenie 插件目录（里面自带的 .git 会让 git status 报 submodule 错）
/.codegenie/
# 发行产物（release/ 下要随仓库发布，其余 *.hap 仍忽略）
!/release/**/*.hap
!/release/**/*.app
!/release/**/*.app.zip
# AGC creds and local state (secrets must never be committed)
tools/agc/credentials.json
# 服务账号密钥文件（含私钥，绝不能进仓库）
tools/agc/private.json
tools/agc/sa.json
tools/agc/*private*.json
tools/relay/config.json
tools/relay/state.json
# App 上报进来的 pushToken（等于"往哪台设备推送"的凭据）
tools/relay/token.json
tools/relay/mqtt-device.json
# FBNS 下发的设备凭据（等同设备身份，不该进仓库）
tools/relay/fbns-auth.json
# CAA 登录的设备签名私钥
tools/relay/usdid.json
# 密码登录后的会话（含 authorization，等同密码）
tools/relay/session.json
# instagrapi 登录后的会话（login_ig.py 产出，等同密码）
tools/relay/settings.json
# CAA 登录产出的 instagrapi 形状会话（--caa-login 产出，同样等同密码）
tools/relay/settings.caa.json
# 网关配置（含分给用户的 key）与登记表
tools/gateway/config.json
tools/gateway/tokens.json
# 登录用的专属浏览器 profile（里面有 IG 会话，等同密码）
tools/relay/.login-profile/
tools/relay/.relay.lock
# release keystore (private key -- never commit)
signing/*.p12
signing/*.cer
signing/*.p7b
*.bak
signing/*.pem
signing/*.backup.p12
